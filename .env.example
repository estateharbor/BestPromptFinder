# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed or shared.

# ============ Deployment (VPS + domain) ============
# Your domain (DNS A record must point at the VPS). Caddy gets HTTPS automatically.
DOMAIN=bestpromptfinder.com
# Postgres password (pick a strong random string):
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# JWT signing secret for login sessions (pick a different long random string):
JWT_SECRET=change-me-to-another-long-random-string

# ============ App settings ============
# Emails allowed to use the admin Upload button (comma-separated):
INGEST_ADMINS=djpandey29@gmail.com
# Daily LLM spend cap in USD (the guard never exceeds this per day):
DAILY_BUDGET_USD=1.0

# ============ LLM (Anthropic) ============
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
LLM_MODEL=claude-sonnet-5
# 1 = Batch API (50% cheaper, async ~1h; best for nightly runs). 0 = synchronous.
LLM_USE_BATCH=1
QUALITY_KEEP=70
QUALITY_REVIEW=45

# ============ Scraper source keys (optional — sources skip if unset) ============
ZENROWS_API_KEY=YOUR_ZENROWS_API_KEY
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME
KAGGLE_KEY=YOUR_KAGGLE_KEY
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY

# Reddit (optional) — create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET
