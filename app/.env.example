# Copy to .env (same folder as docker-compose.yml) and change the secrets.
# docker compose reads this automatically.

# Postgres password (used by both the db and the backend's DATABASE_URL)
POSTGRES_PASSWORD=change-this-strong-password

# JWT signing secret — make it a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-to-a-long-random-string

# Where the browser loads the app from (backend CORS allowlist)
CORS_ORIGINS=http://localhost:8080

# Public domain for the Caddy HTTPS proxy (docker-compose.prod.yml).
# Use a real DNS-pointed domain for a Let's Encrypt cert; localhost for a test cert.
DOMAIN=localhost

# Optional — share rate limits across backend replicas (else in-memory per instance)
# RATELIMIT_STORAGE_URI=redis://redis:6379

# Optional — enables the LLM search enricher + live output previews
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Hard daily spend cap (USD) across all LLM calls; when reached, features fall back to non-LLM.
DAILY_BUDGET_USD=1.0

# --- Optional scraper source keys (used by the nightly `pipeline` worker) ---
# Sources without their key simply skip. See app/DEPLOY.md.
ZENROWS_API_KEY=
GITHUB_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
